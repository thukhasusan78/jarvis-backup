BOT_NAME=Jarvis
# Tunnel mode: bind localhost; Cloudflare Tunnel reaches 127.0.0.1:8000
HOST=127.0.0.1
PORT=8000

# Required — Telegram owner Bot API
TELEGRAM_TOKEN=
ALLOWED_USER_ID=

# Required — Gemini keys (comma-separated for rotation)
GEMINI_API_KEYS=

# Pyrogram userbot
API_ID=
API_HASH=

# Business
VIP_CHANNEL_ID=
VIP_CHAT_ID=

# Search / movies
TAVILY_KEY=
TMDB_API_KEY=
TELEGRAM_CHANNEL_ID=@thukhatech

# Voice HUD — Origins allowed for /ws/voice (empty = allow all for local dev)
# Production: https://jarvis.thukha.online
VOICE_ALLOWED_ORIGINS=https://jarvis.thukha.online
